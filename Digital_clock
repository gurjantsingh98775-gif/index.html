<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>डिजिटल घड़ी और स्टॉपवॉच</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center min-h-screen p-4">

    <!-- मुख्य ऐप कंटेनर -->
    <div class="w-full max-w-md bg-slate-800 rounded-2xl shadow-2xl overflow-hidden border border-slate-700 p-6 text-center">
        
        <!-- टैब स्विच करने के बटन -->
        <div class="flex justify-center mb-6 bg-slate-900 p-1 rounded-xl">
            <button onclick="switchTab('clock')" id="tab-clock" class="flex-1 py-2 rounded-lg font-semibold bg-indigo-600 text-white transition">घड़ी (Clock)</button>
            <button onclick="switchTab('stopwatch')" id="tab-stopwatch" class="flex-1 py-2 rounded-lg font-semibold text-slate-400 hover:text-white transition">स्टॉपवॉच</button>
        </div>

        <!-- 1. डिजिटल घड़ी सेक्शन -->
        <div id="section-clock" class="space-y-4">
            <div id="date-display" class="text-indigo-400 font-medium text-lg"></div>
            <div id="time-display" class="text-5xl font-extrabold tracking-wider bg-slate-950 py-6 rounded-xl border border-slate-700 shadow-inner">00:00:00</div>
            <div id="ampm-display" class="text-slate-400 text-sm uppercase tracking-widest font-semibold"></div>
        </div>

        <!-- 2. स्टॉपवॉच सेक्शन -->
        <div id="section-stopwatch" class="hidden space-y-6">
            <div id="sw-display" class="text-5xl font-extrabold tracking-wider bg-slate-950 py-6 rounded-xl border border-slate-700 shadow-inner">00:00:00</div>
            <div class="flex justify-center gap-3">
                <button onclick="startStopwatch()" id="sw-start-btn" class="bg-emerald-600 hover:bg-emerald-500 px-6 py-3 rounded-xl font-semibold transition shadow-lg shadow-emerald-600/30">शुरू करें</button>
                <button onclick="resetStopwatch()" class="bg-red-600/20 text-red-400 hover:bg-red-600/30 px-6 py-3 rounded-xl font-semibold transition border border-red-500/30">रीसेट</button>
            </div>
        </div>

    </div>

    <!-- JavaScript लॉजिक -->
    <script>
        // --- डिजिटल घड़ी का लॉजिक ---
        function updateClock() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            
            hours = hours % 12;
            hours = hours ? hours : 12; // 0 को 12 बनाएं
            const formattedHours = String(hours).padStart(2, '0');

            document.getElementById('time-display').innerText = `${formattedHours}:${minutes}:${seconds}`;
            document.getElementById('ampm-display').innerText = ampm;

            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('date-display').innerText = now.toLocaleDateString('hi-IN', options);
        }
        setInterval(updateClock, 1000);
        updateClock();

        // --- टैब स्विच करने का लॉजिक ---
        function switchTab(tab) {
            if(tab === 'clock') {
                document.getElementById('section-clock').classList.remove('hidden');
                document.getElementById('section-stopwatch').classList.add('hidden');
                document.getElementById('tab-clock').className = 'flex-1 py-2 rounded-lg font-semibold bg-indigo-600 text-white transition';
                document.getElementById('tab-stopwatch').className = 'flex-1 py-2 rounded-lg font-semibold text-slate-400 hover:text-white transition';
            } else {
                document.getElementById('section-clock').classList.add('hidden');
                document.getElementById('section-stopwatch').classList.remove('hidden');
                document.getElementById('tab-stopwatch').className = 'flex-1 py-2 rounded-lg font-semibold bg-indigo-600 text-white transition';
                document.getElementById('tab-clock').className = 'flex-1 py-2 rounded-lg font-semibold text-slate-400 hover:text-white transition';
            }
        }

        // --- स्टॉपवॉच का लॉजिक ---
        let swInterval;
        let swSeconds = 0, swMinutes = 0, swHours = 0;
        let isRunning = false;

        function startStopwatch() {
            if (!isRunning) {
                isRunning = true;
                document.getElementById('sw-start-btn').innerText = 'रोकें (Stop)';
                document.getElementById('sw-start-btn').className = 'bg-amber-600 hover:bg-amber-500 px-6 py-3 rounded-xl font-semibold transition shadow-lg shadow-amber-600/30';
                swInterval = setInterval(() => {
                    swSeconds++;
                    if (swSeconds === 60) {
                        swSeconds = 0;
                        swMinutes++;
                        if (swMinutes === 60) {
                            swMinutes = 0;
                            swHours++;
                        }
                    }
                    let h = String(swHours).padStart(2, '0');
                    let m = String(swMinutes).padStart(2, '0');
                    let s = String(swSeconds).padStart(2, '0');
                    document.getElementById('sw-display').innerText = `${h}:${m}:${s}`;
                }, 1000);
            } else {
                isRunning = false;
                clearInterval(swInterval);
                document.getElementById('sw-start-btn').innerText = 'चालू रखें';
                document.getElementById('sw-start-btn').className = 'bg-emerald-600 hover:bg-emerald-500 px-6 py-3 rounded-xl font-semibold transition shadow-lg shadow-emerald-600/30';
            }
        }

        function resetStopwatch() {
            isRunning = false;
            clearInterval(swInterval);
            swSeconds = 0; swMinutes = 0; swHours = 0;
            document.getElementById('sw-display').innerText = '00:00:00';
            document.getElementById('sw-start-btn').innerText = 'शुरू करें';
            document.getElementById('sw-start-btn').className = 'bg-emerald-600 hover:bg-emerald-500 px-6 py-3 rounded-xl font-semibold transition shadow-lg shadow-emerald-600/30';
        }
    </script>
</body>
</html>
